# ─────────────────────────────────────────────────────────────
# Source: https://github.com/SomeEngineer42/workstation
#   Path in repo:  common/applications/kill-chat-apps.desktop
#   Installed to:  ~/.local/share/applications/kill-chat-apps.desktop  (a copy, not a symlink)
#
# If you're reading this on the machine and want to change it,
# edit the file in the workstation repo and re-run install.sh.
# Do not edit the installed copy directly — install.sh will
# overwrite it on the next run.
# ─────────────────────────────────────────────────────────────
[Desktop Entry]
Type=Application
Name=Kill Discord & Zoom
Comment=Force-quit Discord and Zoom
Exec=sh -c "pkill -if '[dD]iscord'; pkill -ix zoom"
Icon=process-stop
Terminal=false
Categories=Utility;
