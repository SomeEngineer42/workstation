# edit the file in the workstation repo and re-run install.sh.
# Do not edit the installed copy directly — install.sh will
# overwrite it on the next run.
# ─────────────────────────────────────────────────────────────
[Unit]
Description=Auto-apply best monitor layout on hotplug (GNOME/Mutter)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/fixdisplays-watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
