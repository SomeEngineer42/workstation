#!/usr/bin/env python3
"""Listen for Mutter MonitorsChanged and run fixdisplays with a short debounce."""

import os
import subprocess
import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

# Resolve the sibling `fixdisplays` script relative to this file so the pair
# works regardless of install location (repo checkout, ~/.local/bin, etc).
SCRIPT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "fixdisplays")
# Delays (ms) after a MonitorsChanged signal. The first is a debounce; the
# later ones catch cases where higher modes appear only after the monitor
# finishes renegotiating (e.g. Samsung PBP toggle exposes 5120x1440 a beat
# after 3840x1440). fixdisplays is idempotent, so extra runs are no-ops.
RUN_DELAYS_MS = (500, 2000, 5000)

_pending = []


def _run():
    try:
        subprocess.run([SCRIPT], check=False)
    except Exception as e:
        print(f"fixdisplays-watch: run failed: {e}", flush=True)
    return False  # remove timeout source


def _schedule_all():
    global _pending
    for src in _pending:
        GLib.source_remove(src)
    _pending = [GLib.timeout_add(d, _run) for d in RUN_DELAYS_MS]


def on_signal(_conn, _sender, _obj, _iface, _signal, _params):
    _schedule_all()


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    bus.signal_subscribe(
        "org.gnome.Mutter.DisplayConfig",
        "org.gnome.Mutter.DisplayConfig",
        "MonitorsChanged",
        "/org/gnome/Mutter/DisplayConfig",
        None,
        Gio.DBusSignalFlags.NONE,
        on_signal,
    )
    print("fixdisplays-watch: listening for MonitorsChanged", flush=True)
    # Also converge at startup in case the session began in a bad state.
    _schedule_all()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
